# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Required: OpenAI API key used by the gRPC server to translate.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Required by Docker Compose: password for Grafana's `admin` user.
GRAFANA_ADMIN_PASSWORD=change-me

# Optional: settings for the HTTP API. The values shown are the defaults.
# TRANSLATE_GRPC_SERVER_ADDRESS=127.0.0.1:50051
# WEB_API_SERVER_HOST=127.0.0.1
# WEB_API_SERVER_PORT=8000
